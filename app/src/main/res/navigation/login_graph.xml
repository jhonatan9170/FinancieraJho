<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_graph"
    app:startDestination="@id/loginDocumentFragment">

    <fragment
        android:id="@+id/loginDocumentFragment"
        android:name="com.example.financierajho.ui.Login.LoginDocumentFragment"
        android:label="LoginDocumentFragment" >
        <action
            android:id="@+id/action_loginDocumentFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.financierajho.ui.Login.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <argument
            android:name="dni"
            app:argType="string"
            android:defaultValue='' />
    </fragment>
</navigation>